{
  "name": "foundry-one",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/ui",
    "packages/database",
    "packages/auth",
    "packages/encryption",
    "packages/security",
    "packages/observability",
    "packages/analytics",
    "packages/jobs",
    "packages/types",
    "packages/providers/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:foundation": "node scripts/verify-monorepo.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.6"
  }
}
