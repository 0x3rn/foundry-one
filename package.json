{
  "name": "foundry-one",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/ui",
    "packages/database",
    "packages/auth",
    "packages/encryption",
    "packages/security",
    "packages/observability",
    "packages/analytics",
    "packages/jobs",
    "packages/types",
    "packages/providers/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build && node scripts/run-cloudflare.mjs build --skipNextBuild",
    "cf:build": "npm run db:generate && npm --workspace @foundry/web run cf:build",
    "cf:preview": "npm run db:generate && npm --workspace @foundry/web run cf:preview",
    "cf:deploy": "npm run db:generate && npm --workspace @foundry/web run cf:deploy",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:foundation": "node scripts/verify-monorepo.mjs",
    "test:rbac": "node --import ./scripts/test-runtime-shim.mjs --import tsx --test scripts/test-rbac.ts",
    "test:auth-guard": "node --import ./scripts/test-runtime-shim.mjs --import tsx --test scripts/test-auth-guard.ts",
    "test:auth-flow": "node --import ./scripts/test-runtime-shim.mjs --import tsx scripts/test-auth-flow.ts",
    "test:credential-vault": "node --import ./scripts/test-runtime-shim.mjs --import tsx --test scripts/test-credential-vault.ts",
    "test:provider-store": "node --import ./scripts/test-runtime-shim.mjs --import tsx --test scripts/test-provider-connection-store.ts",
    "test:authorization-boundary": "node --import ./scripts/test-runtime-shim.mjs --import tsx --test scripts/test-authorization-boundary.ts",
    "test:supabase-provider": "node --import ./scripts/test-runtime-shim.mjs --import tsx --test scripts/test-supabase-provider.ts",
    "test:control-center": "node --import ./scripts/test-runtime-shim.mjs --import tsx --test scripts/test-control-center.ts",
    "test:database-transfer": "node --import ./scripts/test-runtime-shim.mjs --import tsx --test scripts/test-database-transfer.ts",
    "test:database-row-editor": "node --import ./scripts/test-runtime-shim.mjs --import tsx --test scripts/test-database-row-editor.ts",
    "test:database-schema-editor": "node --import ./scripts/test-runtime-shim.mjs --import tsx --test scripts/test-database-schema-editor.ts",
    "test:database-api-response": "node --import ./scripts/test-runtime-shim.mjs --import tsx --test scripts/test-database-api-response.ts",
    "test:database-live": "node --import ./scripts/test-runtime-shim.mjs --import tsx scripts/test-live-database-explorer.ts",
    "test:confirmation-challenge": "node --import ./scripts/test-runtime-shim.mjs --import tsx --test scripts/test-confirmation-challenge-store.ts",
    "test:provider-contracts": "node --import ./scripts/test-runtime-shim.mjs --import tsx --test scripts/test-provider-contracts.ts",
    "test:sql-safety": "node --import ./scripts/test-runtime-shim.mjs --import tsx --test scripts/test-sql-safety.ts",
    "test:sql-studio": "node --import ./scripts/test-runtime-shim.mjs --import tsx --test scripts/test-sql-studio.ts",
    "test:database-insights": "node --import ./scripts/test-runtime-shim.mjs --import tsx --test scripts/test-database-insights.ts",
    "test:ui-primitives": "node --import ./scripts/test-runtime-shim.mjs --import tsx --test scripts/test-ui-primitives.ts",
    "test:workspace": "node --import ./scripts/test-runtime-shim.mjs --import tsx --test scripts/test-workspace-service.ts",
    "db:generate": "node scripts/run-prisma.mjs generate",
    "db:validate": "node scripts/run-prisma.mjs validate",
    "db:migrate:dev": "node scripts/run-prisma.mjs migrate dev",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prisma": "^6.12.0",
    "tsx": "^4.23.13",
    "turbo": "^2.5.6"
  }
}
